{
  "name": "llm-charge",
  "version": "1.0.0",
  "description": "Local LLM optimization platform with hybrid routing, cost tracking, and workflow automation (in active development)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:backend": "cd backend && uv run -m uvicorn app.main:app --host 0.0.0.0 --port 7891 --reload",
    "dev:frontend": "vite --host",
    "dev:all": "sh -c 'export PATH=/usr/local/opt/node@22/bin:$PATH && node /usr/local/opt/node@22/lib/node_modules/npm/bin/npm-cli.js run dev:all:exec'",
    "dev:all:exec": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "build:react": "NODE_ENV=production vite build",
    "build:react:dev": "NODE_ENV=development vite build",
    "build:analyze": "ANALYZE=true NODE_ENV=production vite build",
    "start:react": "vite preview",
    "preview:production": "npm run build:react && vite preview",
    "backend:start": "cd backend && venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "backend:dev": "cd backend && venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "backend:test": "cd backend && venv/bin/python -m pytest tests/ -v",
    "dev:react": "vite --host",
    "dev:python": "cd backend && venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:full": "concurrently \"npm run dev:python\" \"npm run dev:react\"",
    "download:samples": "bash scripts/download-sample-projects.sh",
    "onboard:samples": "bash scripts/onboard-sample-projects.sh",
    "test": "jest --config=jest.config.react.cjs",
    "test:react": "jest --config=jest.config.react.cjs",
    "test:react:unit": "jest --config=jest.config.react.cjs tests/unit/react",
    "test:watch": "jest --config=jest.config.react.cjs --watch",
    "test:coverage": "jest --config=jest.config.react.cjs --coverage",
    "test:coverage:react": "jest --config=jest.config.react.cjs --coverage",
    "test:ci": "jest --config=jest.config.react.cjs --ci --coverage --watchAll=false",
    "lint": "eslint src/react --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist build .llm-charge-cache coverage",
    "zip": "bash scripts/create-release-zip.sh",
    "zip:win": "scripts\\create-release-zip.bat",
    "update": "bash scripts/pseudo-git-update.sh",
    "update:dry-run": "bash scripts/pseudo-git-update.sh --dry-run",
    "update:backup": "bash scripts/pseudo-git-update.sh --backup",
    "update:force": "bash scripts/pseudo-git-update.sh --force",
    "update:win": "scripts\\pseudo-git-update.bat",
    "llama-swap:start": "/Users/jacob.brandt/go/bin/llama-swap -config config/llama-swap.yaml -listen :3333",
    "llama-swap:status": "curl http://localhost:3333/api/status",
    "models:download": "bash scripts/download-models.sh"
  },
  "keywords": [
    "llm",
    "local-ai",
    "code-intelligence",
    "semantic-search",
    "recursive-reasoning",
    "api-optimization",
    "cost-reduction"
  ],
  "author": "LLM-Charge Contributors",
  "license": "MIT",
