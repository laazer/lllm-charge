{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/react/*"],
      "@/components/*": ["src/react/components/*"],
      "@/hooks/*": ["src/react/hooks/*"],
      "@/store/*": ["src/react/store/*"],
      "@/utils/*": ["src/react/utils/*"],
      "@/types/*": ["src/react/types/*"],
      "@/api/*": ["src/react/api/*"]
    }
  },
  "include": [
    "src/react/**/*",
    "tests/unit/react/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}