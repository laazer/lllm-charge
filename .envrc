# direnv: match Node to .nvmrc (required for Vite 8 / this repo).
# Pin Python to .python-version (same major as backend/Dockerfile).
# After first clone: `direnv allow`

watch_file .nvmrc
watch_file .python-version

if has fnm; then
  fnm use --install-if-missing
  eval "$(fnm env)"
elif [[ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]]; then
  # shellcheck source=/dev/null
  source "${NVM_DIR:-$HOME/.nvm}/nvm.sh"
  nvm use
else
  log_error "Install fnm (https://github.com/Schniz/fnm) or nvm so Node matches .nvmrc, then: direnv allow"
fi

layout node

# --- Python (backend FastAPI): Homebrew first (reliable ssl/readline on macOS), pyenv fallback ---
_py_ver=$(grep -v '^#' .python-version 2>/dev/null | head -1 | tr -d '[:space:]' || echo 3.11)
_brew_py_prefix=""
if command -v brew >/dev/null 2>&1; then
  _brew_py_prefix="$(brew --prefix "python@${_py_ver}" 2>/dev/null || true)"
fi

if [[ -n "$_brew_py_prefix" && -x "${_brew_py_prefix}/bin/python${_py_ver}" ]]; then
  PATH_add "${_brew_py_prefix}/libexec/bin"
  unset PYENV_VERSION
  log_status "Python: Homebrew python@${_py_ver} at ${_brew_py_prefix} ($(python --version 2>&1))"
elif [[ -x /opt/homebrew/opt/python@${_py_ver}/bin/python${_py_ver} ]]; then
  PATH_add "/opt/homebrew/opt/python@${_py_ver}/libexec/bin"
  unset PYENV_VERSION
  log_status "Python: Homebrew python@${_py_ver} (Apple Silicon default path)"
elif [[ -x /usr/local/opt/python@${_py_ver}/bin/python${_py_ver} ]]; then
  PATH_add "/usr/local/opt/python@${_py_ver}/libexec/bin"
  unset PYENV_VERSION
  log_status "Python: Homebrew python@${_py_ver} (Intel default path)"
elif [[ -d "${PYENV_ROOT:-$HOME/.pyenv}" ]]; then
  export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
  PATH_add "$PYENV_ROOT/bin"
  PATH_add "$PYENV_ROOT/shims"
  export PYENV_VERSION="$_py_ver"
  log_status "Python: pyenv $_py_ver (fallback; brew install python@${_py_ver} is preferred on macOS)"
elif command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - 2>/dev/null)"
  export PYENV_VERSION="$_py_ver"
  PATH_add "$(pyenv root)/shims"
  log_status "Python: pyenv $_py_ver (fallback)"
else
  log_warn "No Homebrew python@${_py_ver} and no pyenv; install: brew install python@${_py_ver}"
fi

unset _brew_py_prefix

# Only activate venv if its interpreter actually runs (avoids stale 3.14 / other-arch copies hijacking PATH)
if [[ -x backend/.venv/bin/python ]]; then
  if backend/.venv/bin/python -c "import ssl" >/dev/null 2>&1; then
    PATH_add backend/.venv/bin
    log_status "Python venv: backend/.venv ($(backend/.venv/bin/python --version 2>&1))"
  else
    log_warn "backend/.venv is broken or wrong architecture (skipping). Recreate: rm -rf backend/.venv && cd backend && python -m venv .venv && pip install -r requirements.txt"
  fi
fi

unset _py_ver
